# Copy this file to .env and fill in your own values to enable the
# optional AI phrasing layer (ai_phrasing.py). This is entirely optional
# — the application works fully without it.
#
# .env is already in .gitignore — never commit your real .env file or
# API key to GitHub.

# Set to "true" to enable AI-assisted statement phrasing.
CV_ANALYZER_AI_ENABLED=false

# Your API key for an OpenAI-compatible chat completions endpoint.
CV_ANALYZER_API_KEY=

# The base URL of that API, WITHOUT a trailing slash and WITHOUT
# "/chat/completions" (that's added automatically).
# Examples:
#   OpenAI itself:        https://api.openai.com/v1
#   A local Ollama server: http://localhost:11434/v1
CV_ANALYZER_API_BASE_URL=https://api.openai.com/v1

# The model name to request, e.g. gpt-4o-mini, llama3, etc. — whatever
# your chosen provider/server supports.
CV_ANALYZER_MODEL_NAME=
